#!/bin/bash

if [ -t 1 ]
then
	red="\033[0;31m"
	green="\033[0;32m"
	blue="\033[1;36m"
	nocolor="\033[0m"
fi

status=0

echo "+----------------+"
echo "|   NORMINETTE   |"
echo "+----------------+"

tools/normcheck repo/
if [ $? -ne 0 ]
then
	status=1
fi

echo -en "${blue}"
echo "+------------+"
echo "|   libft:   |"
echo "+------------+"
echo -en "${nocolor}"

echo "+---------------------+"
echo "|   COMPILE LIBRARY   |"
echo "+---------------------+"

lib_target=all
if grep -qE '^[[:space:]]*bonus[[:space:]]*:' repo/Makefile
then
	lib_target=bonus
fi

make -s -C repo/ "$lib_target" clean
if [ $? -ne 0 ]
then
	echo -e "${red}Errors while compiling the library${nocolor}"
	make -s -C repo/ fclean
	exit 1
else
	echo -e "${green}Library compiled successfully!${nocolor}"
fi

echo "+---------------------+"
echo "|   CHECK SYMBOLS     |"
echo "+---------------------+"

make -s -C tools/ all
if [ $? -ne 0 ]
then
	echo -e "${red}Errors while compiling symbol tools${nocolor}"
	exit 1
fi

tools/symbolcheck repo/libft.a libft/symbols/functions libft/symbols/externals

echo "+-------------------+"
echo "|   COMPILE TESTS   |"
echo "+-------------------+"

make -s  -C libft/ all clean
if [ $? -ne 0 ]
then
	echo -e "${red}Errors while compiling tests${nocolor}"
	make -s -C libft/ fclean
	exit 1
else
	echo -e "${green}Tests compiled successfully!${nocolor}"
fi

echo "+-----------+"
echo "|   TESTS   |"
echo "+-----------+"

libft/test.out
if [ $? -ne 0 ]
then
	status=1
fi

make -s -C libft/ fclean
